# Copy outside the repository, fill deployment values, then use docker --env-file.
# This is KEY=VALUE syntax, not a shell script. Do not use source on this file.
MODEL_PATH=/models/Qwen3.8-27B-GSQ-RCO-IQ3_S.gguf
LLAMA_SERVER=/opt/llamacpp/llama-server
SLANG_BIN=/opt/slang/12.0/bin/slang
EDA_TMP=/var/tmp/eda
AGENT_TMP=/var/tmp/rtl-agent
RUN_ARCHIVE_DIR=/var/tmp/rtl-agent/rtl-runs
RUN_ARCHIVE_MB=8192
PORT=7860
AGENT_STREAM=1
# Existing licensing is tested first; the official server is a startup fallback.
# XILINXD_LICENSE_FILE=your-license-server-or-file
# FLEXLM_TIMEOUT=300000000
# Pre-fill a private token file and mount it read-only; no interactive input is needed.
# FPGACHINA_TOKEN_FILE=/private/fpga-token.txt
# The base image supplies XILINX_VIVADO/XILINX_VITIS, PATH and runtime libraries.
# GPU_DRM_CARD is detected from the single visible AMD /dev/dri/cardN device.
# If only render nodes are mounted, explicitly supply GPU_DRM_CARD and GPU_ASSIGNED_COUNT.
# GPU_DRM_CARD=cardN
# GPU_ASSIGNED_COUNT=1
